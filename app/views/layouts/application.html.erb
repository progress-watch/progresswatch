<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <title><%= content_for(:html_title).presence || "Progress Watch | #{t('watch_any_process')}" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= render 'shared/meta' %>
    <% if indexable? %>
      <link rel="canonical" href="<%= locale_url(I18n.locale) %>">
      <% if translated? %>
        <% Locales::NAMES.each_key do |locale| %>
          <link rel="alternate" hreflang="<%= locale %>" href="<%= locale_url(locale) %>">
        <% end %>
        <link rel="alternate" hreflang="x-default" href="<%= locale_url(I18n.default_locale) %>">
      <% end %>
    <% else %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>
    <% if ProgressWatch.multitenant? %>
      <link rel="describedby" href="<%= llms_url %>">
    <% end %>
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-180.png">
    <link rel="icon" href="/icons/logo.svg" type="image/svg+xml">
    <link rel="icon" href="/icons/icon-192.png" type="image/png">
    <meta name="theme-color" content="#2145e0">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Progress Watch">
    <script>
      try {
        var theme = JSON.parse(localStorage.getItem('progresswatch.profile') || '{}').settings?.theme
        if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme)
      } catch (error) {}
    </script>
    <%= csrf_meta_tags %>
    <%= javascript_pack_tag 'application', defer: true %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
  </head>
  <body class="h-full bg-zinc-100 text-zinc-900 antialiased dark:bg-zinc-800 dark:text-zinc-100">
    <%= render 'shared/navbar' %>
    <main class="mx-auto <%= content_for(:container_width).presence || 'max-w-5xl' %> px-4 py-8 sm:py-12">
      <%= yield %>
    </main>
    <turbo-frame id="modal"></turbo-frame>
  </body>
</html>
