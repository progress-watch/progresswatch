<% styles = { 'get' => 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300', 'post' => 'bg-brand-100 text-brand-800 dark:bg-brand-900/40 dark:text-brand-300', 'put' => 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300', 'patch' => 'bg-zinc-200 text-zinc-600 dark:bg-zinc-600 dark:text-zinc-200', 'delete' => 'bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300' } %>
<span class="shrink-0 rounded px-1.5 py-0.5 text-center font-mono text-[10px] font-semibold uppercase tracking-wide <%= styles.fetch(method, styles['patch']) %> <%= local_assigns[:class] %>"><%= method %></span>
