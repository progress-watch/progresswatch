<p><%= t('everything_is_an_environment_variable') %></p>
<h2><%= t('general') %></h2>
<div class="scrolls">
  <table>
    <thead><tr><th><%= t('variable') %></th><th><%= t('default') %></th><th><%= t('what_it_does') %></th></tr></thead>
    <tbody>
      <tr><td><code>SECRET_KEY_BASE</code></td><td><code>/data/progresswatch/progresswatch.env</code></td><td><%= t('generated_on_first_start_and_kept_on_the_volume') %></td></tr>
      <tr><td><code>DATABASE_URL</code></td><td><code>sqlite3:/data/progresswatch/db.sqlite3</code></td><td><%= t('where_spaces_and_task_structure_live_html', postgres: tag.code('postgresql://…')) %></td></tr>
      <tr><td><code>FORCE_SSL</code></td><td><code>false</code></td><td><%= t('set_true_when_something_in_front_terminates_tls_html', value: tag.code('true'), assume: tag.code('assume_ssl')) %></td></tr>
      <tr><td><code>PORT</code></td><td><code>3000</code></td><td><%= t('the_port_puma_binds_inside_the_container_html', compose: tag.code('docker-compose.yml')) %></td></tr>
      <tr><td><code>RAILS_LOG_LEVEL</code></td><td><code>info</code></td><td><%= t('logs_go_to_stdout_and_nowhere_else_this_is_how_much_of_them') %></td></tr>
      <tr><td><code>RATE_LIMIT_PER_HOUR</code></td><td>—</td><td><%= t('how_many_spaces_and_tasks_one_address_may_create_per_hour') %></td></tr>
    </tbody>
  </table>
</div>
<p><%= t('behind_a_proxy_the_limit_is_only_as_good_as_the_address_html', limit: tag.code('RATE_LIMIT_PER_HOUR'), forwarded: tag.code('X-Forwarded-For')) %></p>
<h2>Redis</h2>
<p><%= t('redis_holds_two_unrelated_things') %></p>
<div class="scrolls">
  <table>
    <thead><tr><th><%= t('variable') %></th><th><%= t('default') %></th><th><%= t('what_it_does') %></th></tr></thead>
    <tbody>
      <tr><td><code>REDIS_URL</code></td><td>—</td><td><%= t('the_server_used_for_both_roles_split_into_db_0_and_db_1') %></td></tr>
      <tr><td><code>PROGRESS_REDIS_URL</code></td><td><code>REDIS_URL</code>, db 0</td><td><%= t('overrides_the_progress_store_alone') %></td></tr>
      <tr><td><code>SIDEKIQ_REDIS_URL</code></td><td><code>REDIS_URL</code>, db 1</td><td><%= t('overrides_the_queue_alone') %></td></tr>
      <tr><td><code>PROGRESS_TTL_SECONDS</code></td><td><code>86400</code></td><td><%= t('how_long_a_task_keeps_its_progress_without_being_written_to') %></td></tr>
      <tr><td><code>PROGRESS_KEY_PREFIX</code></td><td><code>pw:progress</code></td><td><%= t('key_prefix_for_the_progress_store') %></td></tr>
    </tbody>
  </table>
</div>
<h2><%= t('notifications') %></h2>
<p><%= t('both_keys_unset_means_the_feature_does_not_exist_no_button_on_a_space') %></p>
<div class="scrolls">
  <table>
    <thead><tr><th><%= t('variable') %></th><th><%= t('default') %></th><th><%= t('what_it_does') %></th></tr></thead>
    <tbody>
      <tr><td><code>VAPID_PUBLIC_KEY</code></td><td>—</td><td><%= t('public_half_of_the_pair_that_signs_every_push') %></td></tr>
      <tr><td><code>VAPID_PRIVATE_KEY</code></td><td>—</td><td><%= t('private_half_never_leaves_the_server') %></td></tr>
      <tr><td><code>VAPID_SUBJECT</code></td><td><code>mailto:hello@progress.watch</code></td><td><%= t('a_contact_address_the_push_services_can_reach') %></td></tr>
      <tr><td><code>PUSH_CONTENT</code></td><td><code>full</code></td><td><%= t('full_puts_the_task_title_in_the_notification_html', full: tag.code('full'), minimal: tag.code('minimal')) %></td></tr>
    </tbody>
  </table>
</div>
<h2><%= t('process_sizing') %></h2>
<div class="scrolls">
  <table>
    <thead><tr><th><%= t('variable') %></th><th><%= t('default') %></th><th><%= t('what_it_does') %></th></tr></thead>
    <tbody>
      <tr><td><code>RAILS_MAX_THREADS</code></td><td><code>5</code></td><td><%= t('puma_threads_per_process_and_the_size_of_both_pools') %></td></tr>
      <tr><td><code>WEB_CONCURRENCY</code></td><td><code>0</code></td><td><%= t('puma_worker_processes_zero_runs_a_single_process') %></td></tr>
      <tr><td><code>SIDEKIQ_CONCURRENCY</code></td><td><code>5</code></td><td><%= t('threads_in_the_sidekiq_process') %></td></tr>
    </tbody>
  </table>
</div>
