<% source = @doc || ConnectSnippets::SECTIONS[@section] %>
<% heading = t(source[:heading]) %>
<% description = t(@doc ? source[:meta_description] : source[:description]) %>
<% content_for :indexable, true unless @space_uuid %>
<% content_for :html_title, "#{heading} | Progress Watch" %>
<% content_for :meta_description, description %>
<div class="flex flex-col gap-8 lg:flex-row lg:items-start">
  <%= render 'shared/docs_nav', current: @section, space_uuid: @space_uuid %>
  <div class="min-w-0 flex-1">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl"><%= heading %></h1>
    <% if @doc %>
      <div class="prose mt-2">
        <%= render template: "docs/#{@doc[:slug]}" %>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">
        <% if ConnectSnippets::SECTIONS[@section][:intro] %>
          <%= t(ConnectSnippets::SECTIONS[@section][:intro]) %>
        <% elsif @space_uuid %>
          <%= t('ready_to_paste_with_your_space_uuid_already_in_it') %>
        <% else %>
          <%= t('these_create_a_space_and_report_into_it_already_have_one') %>
        <% end %>
      </p>
      <div class="mt-6">
        <%= render 'shared/snippet', steps: ConnectSnippets.call(@section, base_url: request.base_url, space_uuid: @space_uuid) %>
      </div>
    <% end %>
  </div>
</div>
