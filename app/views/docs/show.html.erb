<% content_for :indexable, true unless @space_uuid %>
<% content_for :html_title, "#{ConnectSnippets::SECTIONS[@section][:heading]} | Progress Watch" %>
<% content_for :meta_description, ConnectSnippets::SECTIONS[@section][:description] %>
<div class="flex flex-col gap-8 lg:flex-row lg:items-start">
  <%= render 'shared/docs_nav', current: @section, space_uuid: @space_uuid %>
  <div class="min-w-0 flex-1">
    <h1 class="text-2xl font-semibold tracking-tight"><%= ConnectSnippets::SECTIONS[@section][:heading] %></h1>
    <% if @space_uuid %>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">
        Ready to paste, with your space UUID already in it.
      </p>
    <% else %>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">
        These create a space and report into it. Already have one? Open it and come back through the Connect menu, and its UUID is filled in for you.
      </p>
    <% end %>
    <div class="mt-6">
      <%= render 'shared/snippet', steps: ConnectSnippets.call(@section, base_url: request.base_url, space_uuid: @space_uuid) %>
    </div>
  </div>
</div>
