<% content_for :html_title, "#{@space.title.presence || t('untitled_space')} | Progress Watch" %>
<remember-space data-uuid="<%= @space.uuid %>" data-title="<%= @space.title %>" data-icon="<%= @space.icon %>" data-server="<%= request.base_url %>"></remember-space>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <div class="flex items-center gap-2.5">
      <% if @space.icon.present? %>
        <span class="text-2xl" aria-hidden="true"><%= @space.icon %></span>
      <% end %>
      <h1 class="min-w-0 break-words text-2xl font-semibold tracking-tight sm:text-3xl">
        <%= @space.title.presence || t('untitled_space') %>
      </h1>
      <%= link_to edit_space_path(@space.uuid), data: { turbo_frame: 'modal' }, 'aria-label': t('rename_this_space'), class: 'mt-1 flex shrink-0 text-zinc-400 transition hover:text-zinc-700 dark:hover:text-zinc-200' do %>
        <%= svg_icon 'gear', class: 'h-4 w-4' %>
      <% end %>
    </div>
    <div class="mt-1 flex items-center gap-2">
      <clipboard-copy class="inline-flex" data-action="click:clipboard-copy#copy" data-text="<%= @space.uuid %>" title="<%= t('copy_the_space_uuid') %>">
        <code class="font-mono text-xs text-zinc-500 transition hover:text-zinc-800 dark:text-zinc-300 dark:hover:text-zinc-200"><%= @space.uuid %></code>
      </clipboard-copy>
      <%= link_to space_link_path(@space.uuid), data: { turbo_frame: 'modal' }, 'aria-label': t('share_this_space'), title: t('the_link_a_qr_code_for_a_phone_and_the_uuid_whoever_has_them_can_read_and_write_here'), class: 'rounded-md p-1 text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-zinc-600 dark:hover:text-zinc-200' do %>
        <%= svg_icon 'share', class: 'h-4 w-4' %>
      <% end %>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <span class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-300">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      <%= t('live') %>
    </span>
    <dropdown-menu class="contents">
      <details class="relative">
        <summary class="btn-ghost list-none px-2 py-1 text-xs" title="<%= t('commands_for_reporting_into_this_space_with_its_uuid_already_filled_in') %>">
          <%= svg_icon 'plug', class: 'h-4 w-4' %>
          <%= t('connect') %>
          <%= svg_icon 'chevron_down', class: 'h-4 w-4' %>
        </summary>
        <div class="card absolute left-0 z-10 mt-2 w-56 max-w-[calc(100vw-2rem)] overflow-hidden p-1 shadow-lg md:left-auto md:right-0">
          <%= render 'shared/connect_links', space_uuid: @space.uuid %>
        </div>
      </details>
    </dropdown-menu>
    <% if ProgressWatch.web_push? %>
      <push-toggle class="group inline-flex" data-uuid="<%= @space.uuid %>" data-key="<%= ProgressWatch::VAPID_PUBLIC_KEY %>" data-state="unknown">
        <button type="button" data-action="click:push-toggle#toggle" class="btn-ghost px-2 py-1 text-xs group-data-[state=unknown]:hidden group-data-[state=unsupported]:hidden" title="<%= t('notify_this_device_when_a_task_here_finishes_registers_it_with_the_server_for_this_space_only') %>">
          <span class="hidden items-center gap-1.5 group-data-[state=off]:inline-flex group-data-[state=denied]:inline-flex">
            <%= svg_icon 'bell', class: 'h-4 w-4' %>
            <%= t('notify_me') %>
          </span>
          <span class="hidden items-center gap-1.5 text-emerald-600 group-data-[state=on]:inline-flex dark:text-emerald-400">
            <%= svg_icon 'bell_off', class: 'h-4 w-4' %>
            <%= t('notifying') %>
          </span>
        </button>
      </push-toggle>
    <% end %>
    <forget-space data-uuid="<%= @space.uuid %>" data-title="<%= @space.title %>" data-i18n="<%= translations(:remove_what_from_this_device, :this_space) %>">
      <button type="button" data-action="click:forget-space#forgetSpace" class="btn-danger px-2 py-1 text-xs" title="<%= t('removes_this_space_from_this_device_only_the_space_and_its_tasks_are_untouched_but_the_uuid_is_the_only_way_back_to_it_so_copy_it_first') %>">
        <%= t('forget') %>
      </button>
    </forget-space>
  </div>
</div>
<poll-frame data-frame="tasks" data-interval="2500"></poll-frame>
<turbo-frame id="tasks" src="<%= space_tasks_path(@space.uuid) %>">
  <%= render 'spaces/tasks_list' %>
</turbo-frame>
<poll-frame data-frame="finished" data-interval="20000"></poll-frame>
<turbo-frame id="finished" src="<%= space_tasks_path(@space.uuid, state: 'finished') %>">
  <%= render 'spaces/history', history: @history, page: @page %>
</turbo-frame>
<turbo-frame id="history"></turbo-frame>
<% if @tasks.empty? && @history['sections'].empty? %>
  <section class="mt-10">
    <h2 class="mb-1 text-sm font-medium text-zinc-500 dark:text-zinc-300"><%= t('report_into_this_space') %></h2>
    <% if ProgressWatch.multitenant? %>
      <p class="mb-3 text-xs text-zinc-500 dark:text-zinc-300"><%= t('nothing_has_reported_into_this_space_yet_past_count_days_old_it_may_be_deleted_at_any_time', count: Spaces::SweepEmpty::EMPTY_FOR.in_days.to_i) %></p>
    <% end %>
    <tab-panels class="card block overflow-hidden">
      <div class="flex flex-wrap gap-1 border-b border-zinc-200 p-1 dark:border-zinc-600">
        <% ConnectSnippets::SECTIONS.each_with_index do |(section, config), index| %>
          <button type="button" data-action="click:tab-panels#select" data-tab="<%= section %>" aria-selected="<%= index.zero? %>" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm font-medium text-zinc-600 aria-selected:bg-zinc-200 aria-selected:text-zinc-900 dark:text-zinc-300 dark:aria-selected:bg-zinc-600 dark:aria-selected:text-zinc-100">
            <%= svg_icon config[:icon], class: 'h-4 w-4 shrink-0' %>
            <%= t(config[:title]) %>
          </button>
        <% end %>
      </div>
      <div class="p-4">
        <% ConnectSnippets::SECTIONS.each_key.with_index do |section, index| %>
          <div data-panel="<%= section %>" <%= 'hidden' unless index.zero? %>>
            <%= render 'shared/snippet', steps: ConnectSnippets.call(section, base_url: request.base_url, space_uuid: @space.uuid) %>
          </div>
        <% end %>
      </div>
    </tab-panels>
  </section>
<% end %>
