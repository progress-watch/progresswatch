<% content_for :html_title, "#{@space.title.presence || 'Space'} | Progress Watch" %>
<remember-space data-uuid="<%= @space.uuid %>" data-title="<%= @space.title %>" data-icon="<%= @space.icon %>" data-server="<%= request.base_url %>"></remember-space>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <div class="flex items-center gap-2.5">
      <% if @space.icon.present? %>
        <span class="text-2xl" aria-hidden="true"><%= @space.icon %></span>
      <% end %>
      <h1 class="min-w-0 break-words text-2xl font-semibold tracking-tight">
        <%= @space.title.presence || 'Untitled space' %>
      </h1>
      <%= link_to edit_space_path(@space.uuid), data: { turbo_frame: 'modal' }, 'aria-label': 'Rename this space', class: 'mt-1 flex shrink-0 text-zinc-400 transition hover:text-zinc-700 dark:hover:text-zinc-200' do %>
        <%= svg_icon 'gear', class: 'h-4 w-4' %>
      <% end %>
    </div>
    <div class="mt-1 flex items-center gap-2">
      <clipboard-copy class="inline-flex" data-action="click:clipboard-copy#copy" data-text="<%= @space.uuid %>" title="Copy the space UUID">
        <code class="font-mono text-xs text-zinc-500 transition hover:text-zinc-800 dark:text-zinc-300 dark:hover:text-zinc-200"><%= @space.uuid %></code>
      </clipboard-copy>
      <clipboard-copy class="inline-flex" data-action="click:clipboard-copy#copy" data-text="<%= space_url(@space.uuid) %>" title="Copy the link to this space. Whoever has it can read and write here.">
        <button type="button" tabindex="-1" aria-label="Copy the link to this space" class="rounded-md p-1 text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-zinc-600 dark:hover:text-zinc-200">
          <%= svg_icon 'share', class: 'h-4 w-4', data: { copy_mark: true } %>
          <%= svg_icon 'check', class: 'h-4 w-4 text-emerald-500', data: { copy_check: true } %>
        </button>
      </clipboard-copy>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <span class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-300">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      Live
    </span>
    <details class="relative">
      <summary class="btn-ghost list-none px-2 py-1 text-xs" title="Commands for reporting into this space, with its UUID already filled in">
        <%= svg_icon 'plug', class: 'h-4 w-4' %>
        Connect
        <%= svg_icon 'chevron_down', class: 'h-4 w-4' %>
      </summary>
      <div class="card absolute left-0 z-10 mt-2 w-56 max-w-[calc(100vw-2rem)] overflow-hidden p-1 shadow-lg md:left-auto md:right-0">
        <%= render 'shared/connect_links', space_uuid: @space.uuid %>
      </div>
    </details>
    <% if ProgressWatch.web_push? %>
      <push-toggle class="group inline-flex" data-url="<%= space_push_path(@space.uuid) %>" data-key="<%= ProgressWatch::VAPID_PUBLIC_KEY %>" data-state="unknown">
        <button type="button" data-action="click:push-toggle#toggle" class="btn-ghost px-2 py-1 text-xs group-data-[state=unknown]:hidden group-data-[state=unsupported]:hidden" title="Notify this device when a task here finishes. Registers it with the server for this space only, and nothing else about you.">
          <span class="hidden items-center gap-1.5 group-data-[state=off]:inline-flex group-data-[state=denied]:inline-flex">
            <%= svg_icon 'bell', class: 'h-4 w-4' %>
            Notify me
          </span>
          <span class="hidden items-center gap-1.5 text-emerald-600 group-data-[state=on]:inline-flex dark:text-emerald-400">
            <%= svg_icon 'bell_off', class: 'h-4 w-4' %>
            Notifying
          </span>
        </button>
      </push-toggle>
    <% end %>
    <forget-space data-uuid="<%= @space.uuid %>" data-title="<%= @space.title %>">
      <button type="button" data-action="click:forget-space#forgetSpace" class="btn-danger px-2 py-1 text-xs" title="Removes this space from this device only. The space and its tasks are untouched — but the UUID is the only way back to it, so copy it first if you might want it.">
        Forget
      </button>
    </forget-space>
  </div>
</div>
<poll-frame data-frame="tasks" data-interval="2500"></poll-frame>
<turbo-frame id="tasks" src="<%= space_tasks_path(@space.uuid) %>">
  <%= render 'spaces/tasks_list' %>
</turbo-frame>
<% if @tasks.empty? %>
  <section class="mt-10">
    <h2 class="mb-1 text-sm font-medium text-zinc-500 dark:text-zinc-300">Report into this space</h2>
    <% if ProgressWatch.multitenant? %>
      <p class="mb-3 text-xs text-zinc-500 dark:text-zinc-300">Nothing has reported into this space yet. Past <%= Spaces::SweepEmpty::EMPTY_FOR.inspect %> old it may be deleted at any time; one task keeps it for good.</p>
    <% end %>
    <tab-panels class="card block overflow-hidden">
      <div class="flex flex-wrap gap-1 border-b border-zinc-200 p-1 dark:border-zinc-600">
        <% ConnectSnippets::SECTIONS.each_with_index do |(section, config), index| %>
          <button type="button" data-action="click:tab-panels#select" data-tab="<%= section %>" aria-selected="<%= index.zero? %>" class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm font-medium text-zinc-600 aria-selected:bg-zinc-100 aria-selected:text-zinc-900 dark:text-zinc-300 dark:aria-selected:bg-zinc-600 dark:aria-selected:text-zinc-100">
            <%= svg_icon config[:icon], class: 'h-4 w-4 shrink-0' %>
            <%= config[:title] %>
          </button>
        <% end %>
      </div>
      <div class="p-4">
        <% ConnectSnippets::SECTIONS.each_key.with_index do |section, index| %>
          <div data-panel="<%= section %>" <%= 'hidden' unless index.zero? %>>
            <%= render 'shared/snippet', steps: ConnectSnippets.call(section, base_url: request.base_url, space_uuid: @space.uuid) %>
          </div>
        <% end %>
      </div>
    </tab-panels>
  </section>
<% end %>
