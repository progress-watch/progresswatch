<% if @tasks.empty? %>
  <div class="card p-8 text-center">
    <p class="text-sm font-medium">Nothing running</p>
    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-300">
      Report progress to this space and it appears here within a couple of seconds.
    </p>
  </div>
<% else %>
  <ul class="space-y-3">
    <%= render partial: 'spaces/task', collection: @tasks, as: :task, locals: { nested: false } %>
  </ul>
<% end %>
