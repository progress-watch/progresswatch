<% if @tasks.empty? %>
  <div class="card p-8 text-center">
    <p class="text-sm font-medium"><%= t('nothing_running') %></p>
    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-300">
      <%= t('report_progress_to_this_space_and_it_appears_here_within_a_couple_of_seconds') %>
    </p>
  </div>
<% else %>
  <ul class="space-y-3">
    <%= render partial: 'spaces/task', collection: @tasks, as: :task, locals: { nested: false } %>
  </ul>
<% end %>
