<%
  progress = task['progress']
  ratio = progress && progress['ratio']
  finished = task['finished_at'].present?
  log = progress && progress['values'] && progress['values']['log']
%>
<li class="<%= nested ? 'rounded-lg border border-zinc-200 p-3 dark:border-zinc-600' : 'card p-4' %>">
  <div class="flex flex-wrap items-center gap-2">
    <span class="min-w-0 break-words text-base font-medium sm:text-sm"><%= task['title'].presence || 'Untitled task' %></span>
    <% if finished %>
      <span class="badge bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
        <%= task['finished_label'] %>
      </span>
    <% elsif progress.nil? %>
      <span class="badge bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">waiting</span>
    <% else %>
      <span class="badge bg-brand-100 text-brand-800 dark:bg-brand-900/40 dark:text-brand-300">running</span>
    <% end %>
    <% if task['source'].present? %>
      <span class="font-mono text-xs text-zinc-400 dark:text-zinc-300"><%= task['source'] %></span>
    <% end %>
  </div>
  <% if progress.nil? %>
    <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-300">Waiting for data…</p>
  <% else %>
    <div class="mt-2">
      <div class="h-2 w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-600">
        <% if ratio %>
          <div class="h-full rounded-full <%= finished ? 'bg-emerald-500' : 'bg-brand-500' %>" style="width: <%= (ratio * 100).round(1) %>%"></div>
        <% end %>
      </div>
      <div class="mt-1.5 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs">
        <span class="font-medium tabular-nums text-zinc-700 dark:text-zinc-300">
          <%= ratio ? "#{(ratio * 100).round(1)}%" : '—' %>
        </span>
        <% if task['counts_label'] %>
          <span class="font-mono tabular-nums text-zinc-500 dark:text-zinc-300"><%= task['counts_label'] %></span>
        <% end %>
        <% (progress['values'] || {}).except('log').each do |key, value| %>
          <span class="font-mono text-zinc-500 dark:text-zinc-300"><%= key %>=<%= value %></span>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if log.present? %>
    <p class="mt-1.5 truncate font-mono text-xs text-zinc-500 dark:text-zinc-300"><%= log %></p>
  <% end %>
  <% if task['children'].present? %>
    <sticky-details class="mt-3 block" data-uuid="<%= task['uuid'] %>">
      <%= tag.details(open: !finished, data: { action: 'toggle:sticky-details#remember' }) do %>
        <summary class="inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-800 dark:text-zinc-300 dark:hover:text-zinc-200">
          <%= svg_icon 'chevron_right', class: 'h-3 w-3 transition-transform', data: { chevron: true } %>
          <%= pluralize(task['children'].size, 'step') %>
        </summary>
        <ul class="mt-2 space-y-2 border-l-2 border-zinc-200 pl-4 dark:border-zinc-600">
          <%= render partial: 'spaces/task', collection: task['children'], as: :task, locals: { nested: true } %>
        </ul>
      <% end %>
    </sticky-details>
  <% end %>
</li>
