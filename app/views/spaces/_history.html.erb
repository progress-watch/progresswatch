<% history['sections'].each do |section| %>
  <h2 class="mb-3 mt-8 text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400"><%= section['heading'] %></h2>
  <ul class="space-y-3">
    <%= render partial: 'spaces/task', collection: section['tasks'], as: :task, locals: { nested: false } %>
  </ul>
<% end %>
<% if history['older_than'] %>
  <% target = page.zero? ? 'history' : "history-#{page}" %>
  <turbo-frame id="<%= target %>" class="mt-3 block">
    <%= link_to t('older_tasks'), space_tasks_path(@space.uuid, state: 'finished', before: history['older_than'], page: page + 1), data: { turbo_frame: target }, class: 'btn-ghost w-full justify-center py-2 text-xs' %>
  </turbo-frame>
<% end %>
