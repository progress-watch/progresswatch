<% if turbo_frame_request? %>
  <turbo-frame id="modal">
    <turbo-modal>
      <dialog class="modal" data-action="close:turbo-modal#dismiss" aria-labelledby="modal-title">
        <div class="modal-box">
          <div class="flex items-center justify-between gap-4 border-b border-zinc-200 pb-3 dark:border-zinc-600">
            <h2 id="modal-title" class="text-base font-medium"><%= title %></h2>
            <form method="dialog">
              <button class="btn-ghost h-7 w-7 p-0 text-lg leading-none" aria-label="Close">&times;</button>
            </form>
          </div>
          <div class="mt-4"><%= yield %></div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button aria-label="Close"></button>
        </form>
      </dialog>
    </turbo-modal>
  </turbo-frame>
<% else %>
  <div class="mx-auto max-w-md">
    <h1 class="mb-4 text-2xl font-semibold tracking-tight"><%= title %></h1>
    <%= yield %>
  </div>
<% end %>
