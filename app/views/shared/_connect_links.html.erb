<% ConnectSnippets::SECTIONS.each do |section, config| %>
  <native-action data-placement="menu" data-icon="<%= config[:icon] %>" data-menu="<%= t('connect') %>" data-menu-icon="plug">
    <%= link_to docs_section_path(section: section, space: local_assigns[:space_uuid] || @space&.uuid, locale: docs_locale), class: 'flex items-center gap-2.5 rounded-md px-3 py-2 text-sm text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-600' do %>
      <%= svg_icon config[:icon], class: 'h-4 w-4 shrink-0' %>
      <%= t(config[:title]) %>
    <% end %>
  </native-action>
<% end %>
