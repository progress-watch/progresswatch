<div class="flex gap-3">
  <div class="w-16 shrink-0">
    <%= f.label :icon, 'Icon', class: 'mb-1.5 block text-sm font-medium' %>
    <icon-input>
      <%= f.text_field :icon, value: local_assigns[:icon], maxlength: 16, autocomplete: 'off', data: { action: 'input:icon-input#trim' }, placeholder: '🚀', 'aria-label': 'Icon', class: 'input px-1 text-center text-xl' %>
    </icon-input>
  </div>
  <div class="min-w-0 flex-1">
    <%= f.label :title, 'Name', class: 'mb-1.5 block text-sm font-medium' %>
    <%= f.text_field :title, value: local_assigns[:title], required: true, autocomplete: 'off', data: { autofocus: true }, placeholder: 'Production', class: 'input' %>
  </div>
</div>
<p class="mt-1.5 text-xs text-zinc-500 dark:text-zinc-400">
  For telling your spaces apart. Neither is a credential, and neither has to be unique.
</p>
