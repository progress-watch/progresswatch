<% content_for :title, "#{@space.title.presence || 'Space'} — Progress Watch" %>

<%# Records the space in this browser, so opening a UUID someone shared is all it
    takes to keep it. There is no server-side list to fall back on. %>
<remember-space data-uuid="<%= @space.uuid %>"
                data-title="<%= @space.title %>"
                data-icon="<%= @space.icon %>"
                data-server="<%= request.base_url %>"></remember-space>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <%# items-start, not centre: a long name wraps to two or three lines on a phone and
        both the icon and the pencil belong beside its first line. %>
    <div class="flex items-start gap-2.5">
      <% if @space.icon.present? %>
        <span class="text-2xl" aria-hidden="true"><%= @space.icon %></span>
      <% end %>

      <h1 class="min-w-0 break-words text-2xl font-semibold tracking-tight">
        <%= @space.title.presence || 'Untitled space' %>
      </h1>

      <%# The icon, the title and this button all sit in the same 2rem line box, so the
          row's items-start lands them on one line without any nudging. %>
      <modal-button data-target="edit-space" class="shrink-0">
        <button type="button" aria-label="Rename this space"
                class="flex h-8 w-8 items-center justify-center rounded-md text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-zinc-200">
          <%= svg_icon 'pencil', class: 'h-[1.125rem] w-[1.125rem]' %>
        </button>
      </modal-button>
    </div>

    <div class="mt-1 flex items-center gap-2">
      <clipboard-copy class="inline-flex" data-text="<%= @space.uuid %>" title="Copy the space UUID">
        <code class="font-mono text-xs text-zinc-500 transition hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200"><%= @space.uuid %></code>
      </clipboard-copy>

      <%# The link and the uuid are separate copies because they are wanted for different
          things: the link to open the dashboard, the uuid to paste into a reporter. %>
      <clipboard-copy class="inline-flex" data-text="<%= dashboard_url(@space.uuid) %>"
                      title="Copy the link to this space. Whoever has it can read and write here.">
        <button type="button" tabindex="-1" aria-label="Copy the link to this space"
                class="rounded-md p-1 text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-zinc-200">
          <%= svg_icon 'share', class: 'h-3.5 w-3.5', data: { copy_mark: true } %>
          <%= svg_icon 'check', class: 'h-3.5 w-3.5 text-emerald-500', data: { copy_check: true } %>
        </button>
      </clipboard-copy>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <span class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      Live
    </span>

    <forget-space data-uuid="<%= @space.uuid %>" data-title="<%= @space.title %>">
      <button type="button" class="btn-ghost px-2 py-1 text-xs"
              title="Removes this space from this browser only. The space and its tasks are untouched — but the UUID is the only way back to it, so copy it first if you might want it.">
        Forget
      </button>
    </forget-space>
  </div>
</div>

<%= render 'shared/modal', id: 'edit-space', title: 'Rename space' do %>
  <%= form_with url: dashboard_path(@space.uuid), method: :patch, class: 'space-y-4' do |f| %>
    <%= render 'shared/space_fields', f: f, title: @space.title, icon: @space.icon %>
    <%= f.submit 'Save', class: 'btn-primary w-full' %>
  <% end %>
<% end %>

<poll-frame data-frame="tasks" data-interval="2500"></poll-frame>

<%# The src lives here and only here — see dashboards/tasks.html.erb for why. %>
<turbo-frame id="tasks" src="<%= tasks_dashboard_path(@space.uuid) %>">
  <%= render 'dashboards/tasks_list' %>
</turbo-frame>

<%# Once something has reported, this is scaffolding the reader is done with — the navbar
    keeps the same snippets one click away. It is deliberately outside the polled frame,
    so it does not vanish under the cursor of someone mid-copy; the first task makes it
    go away on the next full load. %>
<% if @tasks.empty? %>
  <section class="mt-10">
    <h2 class="mb-3 text-sm font-medium text-zinc-500 dark:text-zinc-400">Report into this space</h2>

    <tab-panels class="card block overflow-hidden">
      <div class="flex flex-wrap gap-1 border-b border-zinc-200 p-1 dark:border-zinc-800">
        <% ConnectSnippets::SECTIONS.each_with_index do |(section, config), index| %>
          <button type="button" data-tab="<%= section %>"
                  aria-selected="<%= index.zero? %>"
                  class="flex items-center gap-2 rounded-md px-3 py-1.5 text-sm text-zinc-600 aria-selected:bg-zinc-100 aria-selected:font-medium aria-selected:text-zinc-900 dark:text-zinc-400 dark:aria-selected:bg-zinc-800 dark:aria-selected:text-zinc-100">
            <%= svg_icon config[:icon], class: 'h-4 w-4 shrink-0' %>
            <%= config[:title] %>
          </button>
        <% end %>
      </div>

      <div class="p-4">
        <% ConnectSnippets::SECTIONS.each_key.with_index do |section, index| %>
          <div data-panel="<%= section %>" <%= 'hidden' unless index.zero? %>>
            <%= render 'shared/snippet',
                       steps: ConnectSnippets.call(section, base_url: request.base_url, space_uuid: @space.uuid) %>
          </div>
        <% end %>
      </div>
    </tab-panels>
  </section>
<% end %>
